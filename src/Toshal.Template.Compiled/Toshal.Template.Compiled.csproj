<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VersionPrefix>2.2.0</VersionPrefix>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Toshal.Template.Compiled</AssemblyName>
    <RootNamespace>Toshal.Template.Compiled</RootNamespace>
    <PackageId>Toshal.Template.Compiled</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Run time of compiled Toshal templates: the base class of the C# classes that Toshal.Template.Generator and the toshal-template tool make from .ctt files. No parser runs at run time.</Description>
    <PackageTags>template;text-template;code-generation;source-generator;compiled-template</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- It uses internal members of Toshal.Template, so the dependency is the exact same version. -->
    <ProjectReference Include="..\Toshal.Template\Toshal.Template.csproj" />
  </ItemGroup>

</Project>
