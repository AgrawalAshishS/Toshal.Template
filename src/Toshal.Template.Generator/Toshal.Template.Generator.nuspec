<?xml version="1.0" encoding="utf-8"?>
<!-- The task targets netstandard2.0 (every MSBuild loads it), but the classes it makes need the net10.0 run time package.
     A project reference cannot carry that dependency across the two frameworks, so the package is described here. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Toshal.Template.Generator</id>
    <version>$version$</version>
    <authors>Toshal Infotech</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/AgrawalAshishS/Toshal.Template</projectUrl>
    <repository type="git" url="https://github.com/AgrawalAshishS/Toshal.Template" />
    <readme>README.md</readme>
    <description>$description$</description>
    <copyright>Copyright (c) 2026 Toshal Infotech</copyright>
    <tags>template text-template code-generation msbuild compiled-template</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Toshal.Template.Compiled" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\netstandard2.0\Toshal.Template.Generator.dll" target="tasks\netstandard2.0" />
    <file src="build\Toshal.Template.Generator.props" target="build" />
    <file src="build\Toshal.Template.Generator.targets" target="build" />
    <file src="..\..\README.md" target="" />
  </files>
</package>
