<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VersionPrefix>2.1.0</VersionPrefix>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Toshal.Template.Generator</AssemblyName>
    <RootNamespace>Toshal.Template.Generator</RootNamespace>

    <PackageId>Toshal.Template.Generator</PackageId>
    <Description>Turns .ctt templates into C# classes at build time: an MSBuild task for Toshal.Template. The template text becomes plain C# code, so no parser runs at run time. Every .ctt file of the project (or the ones you list) gets Name.g.cs next to it on each build, and a stub for your values (Name.cs) is made once.</Description>
    <PackageTags>template;text-template;code-generation;msbuild;compiled-template</PackageTags>
    <!-- The package is described by the .nuspec: the task dll goes to tasks/, and it depends on the run time package. -->
    <NuspecFile>Toshal.Template.Generator.nuspec</NuspecFile>
    <NuspecProperties>version=$(VersionPrefix);configuration=$(Configuration);description=$(Description)</NuspecProperties>
  </PropertyGroup>

  <Import Project="..\Toshal.Template.CodeGen\CodeGenSources.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.7.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="System.Memory" Version="4.5.5" PrivateAssets="all" />
  </ItemGroup>

</Project>
