<?xml version="1.0"?>
<package >
    <metadata>
        <id>Toshal.Template</id>
        <version>$version$</version>
        <title>Toshal.Template</title>
        <authors>Ashish Agrawal, Toshal Infotech</authors>
        <owners>Ashish Agrawal, Toshal Infotech</owners>
        <projectUrl>http://www.toshalinfotech.com</projectUrl>
        <iconUrl>http://www.toshalinfotech.com/favicon.ico</iconUrl>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <licenseUrl>http://www.toshalinfotech.com</licenseUrl>

        <summary>Provides fast string based templates.</summary>
        <description>Provides fast string based templates.</description>

        <copyright>Copyright 2016</copyright>

        <tags>Template</tags>

        <dependencies>
            <group targetFramework=".NETFramework4.5">
            </group>
            <group targetFramework=".NETStandard1.0">
                <dependency id="NETStandard.Library" version="[1.6.0, )" />
            </group>
        </dependencies>
    </metadata>
</package>