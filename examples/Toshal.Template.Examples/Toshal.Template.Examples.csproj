<Project Sdk="Microsoft.NET.Sdk">

  <!-- The compiled templates (CompiledTemplates\*.ctt) use the generator of this repository, the way the package would. -->
  <Import Project="..\..\src\Toshal.Template.Generator\build\Toshal.Template.Generator.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Toshal.Template\Toshal.Template.csproj" />
    <ProjectReference Include="..\..\src\Toshal.Template.Compiled\Toshal.Template.Compiled.csproj" />
    <ProjectReference Include="..\..\src\Toshal.Template.Generator\Toshal.Template.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used only by the fake or real database pattern example. -->
    <PackageReference Include="NpgsqlCommon" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The template files are compiled into the assembly, so the examples need no files next to the exe. -->
    <EmbeddedResource Include="Templates\**\*.txt" />
  </ItemGroup>

  <PropertyGroup>
    <ToshalTemplateTaskAssembly>$(MSBuildThisFileDirectory)..\..\src\Toshal.Template.Generator\bin\$(Configuration)\netstandard2.0\Toshal.Template.Generator.dll</ToshalTemplateTaskAssembly>
  </PropertyGroup>

  <Import Project="..\..\src\Toshal.Template.Generator\build\Toshal.Template.Generator.targets" />

</Project>
